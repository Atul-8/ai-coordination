{
  "name": "dsh-eai-workflow",
  "version": "1.0.0",
  "description": "七层分治协调框架的 DSH bundle：eai_* 工具 + /eai-* 命令 + EAI 预设 + 技能，项目数据落在 .ai/ 与 todo.md",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "templates",
    "scripts",
    "skills",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/lib.test.mjs test/pool.test.mjs test/plugin.test.mjs test/full.test.mjs"
  },
  "keywords": [
    "dsh-bundle",
    "deepseek-harness",
    "eai",
    "workflow",
    "coordination",
    "agents",
    "todo",
    "plans"
  ],
